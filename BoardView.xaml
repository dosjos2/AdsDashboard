<UserControl x:Class="DevOpsPulse.BoardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="30,24,20,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,10,20"><TextBlock Text="Teamets board" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Dra kort til en kolonne, eller bruk «Flytt til». Klikk på tittelen for å åpne oppgaven." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="WriteHint" Text="Flytting lagres i Azure DevOps og krever Work Items: Read &amp; write. Boardet bruker egne prosjekt- og teamvalg." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  <WrapPanel x:Name="Selectors" Grid.Row="1" Margin="0,0,0,12">
   <StackPanel Margin="0,0,12,10"><TextBlock Text="PROSJEKT" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,6"/><ComboBox x:Name="BoardProject" Width="180" SelectionChanged="ProjectChanged" AutomationProperties.Name="Board-prosjekt"/></StackPanel>
   <StackPanel Margin="0,0,12,10"><TextBlock Text="TEAM" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,6"/><ComboBox x:Name="BoardTeam" Width="200" DisplayMemberPath="Name" SelectionChanged="TeamChanged" AutomationProperties.Name="Board-team"/></StackPanel>
   <StackPanel Margin="0,0,12,10"><TextBlock Text="BOARD" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,6"/><ComboBox x:Name="BoardChoice" Width="180" DisplayMemberPath="Name" SelectionChanged="BoardChanged" AutomationProperties.Name="Velg board"/></StackPanel>
   <Button x:Name="ReloadButton" Content="↻ Oppdater board" Click="ReloadClick" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
  </WrapPanel>
  <StackPanel Grid.Row="2" Margin="0,0,10,15">
   <WrapPanel Margin="0,0,0,10"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="235" ToolTip="Søk etter ID, tittel, type eller person" AutomationProperties.Name="Søk i boardet"/><CheckBox Content="Bare mine oppgaver" IsChecked="{Binding OnlyMine}" Margin="18,0,0,0"/></WrapPanel>
   <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}"/>
   <TextBlock x:Name="BoardStatus" Foreground="#65758D" TextWrapping="Wrap" Margin="0,7,0,0"/>
   <ProgressBar x:Name="BoardBusy" Visibility="Collapsed" IsIndeterminate="True" Height="3" Margin="0,10,0,0"/>
  </StackPanel>
  <ScrollViewer x:Name="BoardScroller" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="LaneItems" ItemsSource="{Binding Columns}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Border Width="270" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,12,0" Background="#EDF1F7" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="10" Padding="12" AllowDrop="True" DragOver="LaneDragOver" DragLeave="LaneDragLeave" Drop="LaneDrop">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="2,2,2,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Lane.Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/><Border Grid.Column="1" Background="White" CornerRadius="5" Padding="8,3" Margin="8,0,0,0"><TextBlock Text="{Binding Count}" FontSize="11"/></Border></Grid><TextBlock Text="{Binding Wip}" FontSize="10" Foreground="#B48335" Margin="0,6,0,0" ToolTip="Antall i hele kolonnen sammenlignet med WIP-grensen, inkludert begge halvdelene av delte kolonner"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="White" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" PreviewMouseLeftButtonDown="CardMouseDown" PreviewMouseMove="CardMouseMove" Cursor="Hand">
       <StackPanel><TextBlock Text="{Binding Metadata}" Foreground="{Binding Item.Color}" FontSize="10" TextWrapping="Wrap"/>
        <Button Content="{Binding Item.Title}" Click="CardOpen" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Margin="0,9,0,0"><Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontWeight="SemiBold"/></DataTemplate></Button.ContentTemplate></Button>
        <TextBlock Text="{Binding Assignee}" Foreground="#7D8BA0" FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Row}" Foreground="#8C98A8" FontSize="10" Margin="0,5,0,0"/>
        <TextBlock Text="Flytt til" Foreground="#8995A7" FontSize="10" Margin="0,12,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Name" MinWidth="0" Padding="5" FontSize="10" ToolTip="Velg kolonne å flytte oppgaven til"/><Button Grid.Column="1" Content="Flytt" Click="CardMove" Padding="8,6" Margin="6,0,0,0" FontSize="10"/></Grid>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
   </Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </Grid>
</UserControl>
