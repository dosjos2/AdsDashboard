<Window x:Class="DevOpsPulse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DevOpsPulse"
        Title="DevOps Pulse" Width="1420" Height="1000" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
 <Window.Resources>
  <DataTemplate x:Key="WorkRow">
   <Border BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="0,13" Cursor="Hand" MouseLeftButtonUp="WorkRowClick">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="42"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" FontSize="18" VerticalAlignment="Center" ToolTip="{Binding TypeLabel}"/>
     <StackPanel Grid.Column="1" Margin="0,0,15,0"><Button Content="{Binding Title}" Click="OpenWorkItem" HorizontalAlignment="Left" BorderThickness="0" Padding="0" Background="Transparent" FontWeight="SemiBold" ToolTip="Åpne oppgaven i et eget vindu"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <Border Grid.Column="2" Background="{Binding StateBackground}" CornerRadius="5" Padding="8,5" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="{Binding State}" Foreground="{Binding StateColor}" FontSize="11"/></Border>
     <TextBlock Grid.Column="3" Text="{Binding PriorityLabel}" Foreground="#8995A7" VerticalAlignment="Center" FontSize="12"/>
     <TextBlock Grid.Column="4" Text="{Binding ChangedLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="PrRow">
   <Border BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
     <TextBlock Text="⑂" Foreground="#7D80CB" FontSize="25" VerticalAlignment="Top"/>
     <StackPanel Grid.Column="1" Margin="0,0,12,0"><Button Content="{Binding Title}" Tag="{Binding Url}" Click="OpenLink" HorizontalAlignment="Left" BorderThickness="0" Padding="0" Background="Transparent" ToolTip="Åpne pull request i Azure DevOps"/>
      <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Branch}" Foreground="#8995A7" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding ReviewLabel}" Foreground="#64748B" FontSize="11" Margin="0,6,0,0" ToolTip="{Binding ReviewTooltip}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Role}" Foreground="#747CB3" FontSize="10" Margin="0,6,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="2" HorizontalAlignment="Right"><Border Background="{Binding StateBackground}" CornerRadius="5" Padding="9,5"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateColor}" FontSize="11"/></Border><TextBlock Text="{Binding AgeLabel}" FontSize="10" Foreground="#8995A7" Margin="0,9,0,0" MaxWidth="90" TextWrapping="Wrap" TextAlignment="Right"/></StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="BuildRow">
   <Border BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
    <Ellipse Width="8" Height="8" Fill="{Binding Color}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1"><Button Content="{Binding Name}" Tag="{Binding Url}" Click="OpenLink" HorizontalAlignment="Left" BorderThickness="0" Padding="0" Background="Transparent"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,5,10,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontSize="12" HorizontalAlignment="Right"/><TextBlock Text="{Binding AgeLabel}" FontSize="10" Foreground="#8995A7" Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Right"/></StackPanel>
   </Grid></Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#19253E"><Grid Margin="18,26,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="11,0,0,34"><StackPanel Orientation="Horizontal"><Border Background="#7C8CFF" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="⌁" FontSize="28" Foreground="White" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border><TextBlock Text="pulse" FontSize="26" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/></StackPanel><TextBlock Text="AZURE DEVOPS, SAMLET" FontSize="9" Foreground="#7B8CA9" Margin="1,14,0,0"/></StackPanel>
   <StackPanel Grid.Row="1"><TextBlock Text="ARBEIDSOMRÅDE" FontSize="9" Foreground="#6B7F9F" Margin="17,0,0,13"/>
    <RadioButton Content="▦    Oversikt" Tag="Oversikt" Style="{StaticResource Nav}" GroupName="Nav" IsChecked="True" Checked="Navigate"/>
    <RadioButton Content="▣    Arbeidsoppgaver" Tag="Arbeidsoppgaver" Style="{StaticResource Nav}" GroupName="Nav" Checked="Navigate"/>
    <RadioButton Content="▤    Board" Tag="Board" Style="{StaticResource Nav}" GroupName="Nav" Checked="Navigate"/>
    <RadioButton Content="⑂    Pull requests" Tag="Pull requests" Style="{StaticResource Nav}" GroupName="Nav" Checked="Navigate"/>
    <RadioButton Content="▷    Pipelines" Tag="Pipelines" Style="{StaticResource Nav}" GroupName="Nav" Checked="Navigate"/>
   </StackPanel>
   <StackPanel Grid.Row="3"><Border Background="#21314D" CornerRadius="9" Padding="14" Margin="0,0,0,20"><StackPanel><TextBlock Text="{Binding Mode}" Foreground="#B5C5E0" FontSize="11"/><TextBlock x:Name="OrgLabel" Text="dev.azure.com/helsedir" Foreground="#7288AA" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/><Button Content="⚙  Tilkobling" Click="ConnectionClick" Background="Transparent" Foreground="#D0DAEC" BorderBrush="#3B4B68" FontSize="11" Margin="0,14,0,0"/></StackPanel></Border>
    <Grid Margin="6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="31" Height="31" CornerRadius="16" Background="#344464" HorizontalAlignment="Left"><TextBlock Text="JS" Foreground="#DFE8FA" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Jan Ole Skotterud" Foreground="#DCE4F2" FontSize="11"/><TextBlock Text="Mitt personlige dashboard" Foreground="#7184A4" FontSize="9" Margin="0,4,0,0"/></StackPanel></Grid>
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#E5EAF1" BorderThickness="0,0,0,1" Padding="30,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="175"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Mitt arbeidsområde" FontWeight="SemiBold"/><TextBlock Text="  /  " Foreground="#BBC3D0"/><TextBlock Text="{Binding Section}" Foreground="#7C879B"/></StackPanel>
    <Grid Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="{Binding ShowDashboard, Converter={StaticResource Bool}}"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Søk etter tittel, ID, prosjekt eller repository" AutomationProperties.Name="Søk i listene"/><TextBlock Text="⌕  Søk i listene…" Foreground="#9AA5B5" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <ComboBox x:Name="ProjectBox" Visibility="{Binding ShowDashboard, Converter={StaticResource Bool}}" Grid.Column="2" ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}" Margin="0,0,14,0" VerticalAlignment="Center" AutomationProperties.Name="Velg prosjekt"/>
    <Button Grid.Column="3" Content="↻  Oppdater" x:Name="RefreshButton" Click="RefreshClick" VerticalAlignment="Center"/>
    <Button Grid.Column="4" Content="{Binding Notifications.ButtonLabel}" Click="NotificationsClick" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Nye tildelinger og @omtaler"/>
   </Grid></Border>
   <ScrollViewer x:Name="MainScroll" Grid.Row="1" Visibility="{Binding ShowDashboard, Converter={StaticResource Bool}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30,26,30,25">
    <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="#8190A5" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock x:Name="DateLabel" Grid.Column="1" Foreground="#8290A4" FontSize="11" VerticalAlignment="Top" Margin="10,12,0,0"/></Grid>
    <Border Visibility="{Binding IsDemo, Converter={StaticResource Bool}}" Background="#EEF0FF" CornerRadius="8" Padding="15,11" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="DEMOVISNING · Alle tall og titler er fiktive. Koble til for å hente dine data fra Helsedir." Foreground="#626FB1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/><Button Grid.Column="1" Content="Koble til DevOps →" Click="ConnectionClick" Style="{StaticResource Primary}" Padding="12,7" FontSize="11"/></Grid></Border>
    <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#FCEEF1" CornerRadius="8" Padding="15" Margin="0,0,0,16"><TextBlock x:Name="ErrorText" Foreground="#AB4558" TextWrapping="Wrap"/></Border>
    <Border Visibility="{Binding HasWarnings, Converter={StaticResource Bool}}" Background="#FFF5DE" CornerRadius="8" Padding="14" Margin="0,0,0,16"><Expander Header="Delvis datagrunnlag – noen data kunne ikke hentes" Foreground="#9B732A"><TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Margin="0,10,0,0"/></Expander></Border>
    <ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#5266E9" Background="#E3E8FA" Margin="0,0,0,14"/>
    <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource Bool}}">
     <UniformGrid Columns="4" Margin="0,0,-14,20">
      <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="ÅPNE OPPGAVER" FontSize="10" Foreground="#8995A9"/><TextBlock Text="{Binding OpenCount}" FontSize="35" FontWeight="SemiBold" Margin="0,10,0,3"/><TextBlock Text="Tildelte arbeidsoppgaver" Style="{StaticResource MutedText}"/><Border Height="3" Background="#4B91D2" CornerRadius="2" Margin="0,18,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="MINE AKTIVE PR-ER" FontSize="10" Foreground="#8995A9"/><TextBlock Text="{Binding MineCount}" FontSize="35" FontWeight="SemiBold" Margin="0,10,0,3"/><TextBlock Text="Opprettet av meg" Style="{StaticResource MutedText}"/><Border Height="3" Background="#9B72D7" CornerRadius="2" Margin="0,18,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="VENTER PÅ MIN REVIEW" FontSize="10" Foreground="#8995A9"/><TextBlock Text="{Binding ReviewCount}" FontSize="35" FontWeight="SemiBold" Margin="0,10,0,3" Foreground="#5266D5"/><TextBlock Text="Aktive, uten min stemme" Style="{StaticResource MutedText}"/><Border Height="3" Background="#5266E9" CornerRadius="2" Margin="0,18,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="ÅPNE BUGS" FontSize="10" Foreground="#8995A9"/><TextBlock Text="{Binding BugCount}" FontSize="35" FontWeight="SemiBold" Margin="0,10,0,3" Foreground="#CD5C74"/><TextBlock Text="Tildelt meg" Style="{StaticResource MutedText}"/><Border Height="3" Background="#DB6178" CornerRadius="2" Margin="0,18,0,0"/></StackPanel></Border>
     </UniformGrid>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Arbeidsbildet" Style="{StaticResource Heading}"/><TextBlock Text="{Binding WorkSummary}" Style="{StaticResource MutedText}" Margin="0,5,0,16"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Width="140" Height="140" HorizontalAlignment="Left"><local:CompletionRing Done="{Binding DoneCount}" Total="{Binding TotalCount}"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding Completion}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="ferdig" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel></Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
         <Grid Margin="0,0,0,6"><TextBlock Text="Tasks" FontSize="12"/><TextBlock Text="{Binding TaskCount}" HorizontalAlignment="Right" FontSize="12"/></Grid><local:DistributionBar Count="{Binding TaskCount}" Total="{Binding OpenCount}" Fill="#4B91D2" Height="6" Margin="0,0,0,13"/>
         <Grid Margin="0,0,0,6"><TextBlock Text="Features" FontSize="12"/><TextBlock Text="{Binding FeatureCount}" HorizontalAlignment="Right" FontSize="12"/></Grid><local:DistributionBar Count="{Binding FeatureCount}" Total="{Binding OpenCount}" Fill="#9B72D7" Height="6" Margin="0,0,0,13"/>
         <Grid Margin="0,0,0,6"><TextBlock Text="Bugs" FontSize="12"/><TextBlock Text="{Binding BugCount}" HorizontalAlignment="Right" FontSize="12"/></Grid><local:DistributionBar Count="{Binding BugCount}" Total="{Binding OpenCount}" Fill="#DB6178" Height="6" Margin="0,0,0,13"/>
         <Grid Margin="0,0,0,6"><TextBlock Text="Product backlog items" FontSize="12"/><TextBlock Text="{Binding PbiCount}" HorizontalAlignment="Right" FontSize="12"/></Grid><local:DistributionBar Count="{Binding PbiCount}" Total="{Binding OpenCount}" Fill="#28A28B" Height="6"/>
        </StackPanel>
       </Grid><TextBlock Text="Andel ferdige av alle dine tildelte oppgaver. Søylene viser fordelingen av åpne oppgaver." Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,15,0,0"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Verdt å følge opp" Style="{StaticResource Heading}"/><TextBlock Text="Små signaler som gjør det enklere å prioritere" Style="{StaticResource MutedText}" Margin="0,5,0,12"/><ItemsControl ItemsSource="{Binding Insights}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="25" Height="25" CornerRadius="7" Background="#F3F5FA" VerticalAlignment="Top" HorizontalAlignment="Left"><TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><Button Content="{Binding Title}" Tag="{Binding Url}" Click="OpenLink" HorizontalAlignment="Left" BorderThickness="0" Padding="0" Background="Transparent" FontSize="11"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#8A96A8" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     </Grid>
    </StackPanel>
    <Border Style="{StaticResource Card}" Visibility="{Binding ShowWork, Converter={StaticResource Bool}}" Margin="0,0,0,20"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Mine arbeidsoppgaver" Style="{StaticResource Heading}"/><TextBlock Text="{Binding WorkListCaption}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Se alle →" Tag="Arbeidsoppgaver" Click="ShowSection" Padding="10,6" VerticalAlignment="Top" Visibility="{Binding IsOverview, Converter={StaticResource Bool}}" FontSize="11"/></Grid>
     <StackPanel Orientation="Horizontal" Margin="0,15,0,5" Visibility="{Binding IsWorkPage, Converter={StaticResource Bool}}"><ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" MinWidth="195" Margin="0,0,18,0"/><CheckBox Content="Vis også ferdige" IsChecked="{Binding IncludeClosed}"/></StackPanel>
     <Grid Margin="32,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="42"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="OPPGAVE / PROSJEKT" Foreground="#9AA5B5" FontSize="9"/><TextBlock Grid.Column="1" Text="STATUS" Foreground="#9AA5B5" FontSize="9"/><TextBlock Grid.Column="2" Text="PRI." Foreground="#9AA5B5" FontSize="9"/><TextBlock Grid.Column="3" Text="ENDRET" Foreground="#9AA5B5" FontSize="9" HorizontalAlignment="Right"/></Grid>
     <ItemsControl ItemsSource="{Binding WorkItems}" ItemTemplate="{StaticResource WorkRow}"/>
     <TextBlock Visibility="{Binding NoWork, Converter={StaticResource Bool}}" Text="Ingen oppgaver i dette utvalget. Prøv et annet filter eller søk." Foreground="#8995A7" Margin="0,28" HorizontalAlignment="Center"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Visibility="{Binding ShowPr, Converter={StaticResource Bool}}" Margin="0,0,0,20"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Pull requests" Style="{StaticResource Heading}"/><TextBlock Text="{Binding PrListCaption}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Se alle →" Tag="Pull requests" Click="ShowSection" Padding="10,6" VerticalAlignment="Top" Visibility="{Binding IsOverview, Converter={StaticResource Bool}}" FontSize="11"/></Grid>
     <StackPanel Orientation="Horizontal" Margin="0,15,0,5" Visibility="{Binding IsPrPage, Converter={StaticResource Bool}}"><ComboBox ItemsSource="{Binding PrRoles}" SelectedItem="{Binding PrRole}" Margin="0,0,18,0"/><CheckBox Content="Vis også fullførte / avbrutte siste 30 dager" IsChecked="{Binding IncludeHistory}"/></StackPanel>
     <ItemsControl ItemsSource="{Binding PullRequests}" ItemTemplate="{StaticResource PrRow}"/>
     <TextBlock Visibility="{Binding NoPr, Converter={StaticResource Bool}}" Text="Ingen pull requests i dette utvalget. Prøv et annet filter eller søk." Foreground="#8995A7" Margin="0,28" HorizontalAlignment="Center"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Visibility="{Binding ShowBuilds, Converter={StaticResource Bool}}"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Pipelines" Style="{StaticResource Heading}"/><TextBlock Text="{Binding PipelineCaption}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Se alle →" Tag="Pipelines" Click="ShowSection" Padding="10,6" VerticalAlignment="Top" Visibility="{Binding IsOverview, Converter={StaticResource Bool}}" FontSize="11"/></Grid>
     <WrapPanel Margin="0,15,0,5"><TextBlock Text="Pipelineprosjekter" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="PipelineProjectBox" ItemsSource="{Binding PipelineProjects}" SelectedItem="{Binding PipelineProject}" MinWidth="175" AutomationProperties.Name="Velg pipelineprosjekter"/><TextBlock Text="Kombineres med prosjektfilteret øverst." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="15,5,0,5"/></WrapPanel>
     <ItemsControl ItemsSource="{Binding Builds}" ItemTemplate="{StaticResource BuildRow}"/>
     <TextBlock Visibility="{Binding NoBuilds, Converter={StaticResource Bool}}" Text="Ingen bygg i utvalget de siste 7 dagene. Kontroller begge prosjektfiltrene og eventuelle tilgangsvarsler." Foreground="#8995A7" Margin="0,28" TextWrapping="Wrap" HorizontalAlignment="Center"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
   <local:BoardView x:Name="WorkBoard" Grid.Row="1" Visibility="{Binding DataContext.IsBoard, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Bool}}"/>
   <Border Grid.Row="2" Background="#F0F3F8" Padding="30,6"><Grid><TextBlock Text="{Binding ScopeNote}" FontSize="9" Foreground="#8995A7"/><TextBlock x:Name="StatusLabel" Text="{Binding Status}" FontSize="9" Foreground="#8995A7" HorizontalAlignment="Right"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
